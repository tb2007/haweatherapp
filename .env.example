# Home Assistant
HA_BASE_URL=http://hatb.ad.bpu.link:8123
HA_TOKEN=your_long_lived_access_token_here

# Auth — change these before deploying
APP_USERNAME=admin
APP_PASSWORD=changeme
JWT_SECRET=change_this_to_a_random_64_char_string

# Set to 'false' when accessing over plain HTTP (e.g. local testing without TLS)
# Leave unset or 'true' when behind an HTTPS reverse proxy
COOKIE_SECURE=true

# Weather Underground forecast API key (from wunderground.com → My Profile → API Keys)
WU_API_KEY=your_wu_api_key_here

# Webcam(s) — set RTSP_URL to enable; leave blank to disable the webcam panel
# go2rtc runs as a sidecar container and transcodes RTSP → MJPEG internally
# The RTSP URL never reaches the browser
RTSP_URL=rtsp://user:pass@camera-ip:554/stream

# Second webcam ("AnimalAlley") — set RTSP_URL_2 to enable; leave blank to disable
# Supports rtsps:// (e.g. UniFi Protect) as well as rtsp://
RTSP_URL_2=rtsps://user:pass@camera-ip:7441/streamid?enableSrtp
